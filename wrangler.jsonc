{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgerly",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledgerly",
      // Placeholder for local dev. Before `npm run deploy`, create a real DB with
      // `wrangler d1 create ledgerly` and paste its id here.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ledgerly-documents"
    }
  ],
  "ai": {
    // Workers AI has no local simulator; wrangler treats this binding as
    // always-remote ("remote" here just acknowledges that and silences a
    // startup warning). In `npm run dev` the binding stays disconnected
    // (errors only when actually called) so a clone without Cloudflare
    // credentials still boots; opt in via LEDGERLY_REMOTE_BINDINGS=true —
    // see vite.config.ts.
    "binding": "AI",
    "remote": true
  },
  // Daily 08:00 UTC tick for proactive briefings. The cadence/config gates in
  // worker/briefings.ts decide whether a tick actually sends anything, so this
  // one schedule serves both the daily and weekly cadences. Local `npm run dev`
  // ignores triggers (no scheduler in the vite plugin) — unaffected.
  "triggers": { "crons": ["0 8 * * *"] },
  "observability": { "enabled": true }
}
